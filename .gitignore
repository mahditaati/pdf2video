# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Build and packaging
dist/
build/
*.egg-info/

# Temporary files and directories
temp_*
*.tmp*
.tmp*
tmp/

# Media and data exclusions (never commit user media or copyrighted audio)
input/*
!input/.gitkeep

output/*
!output/.gitkeep

music/*
!music/.gitkeep

# Exclude audio, video, and PDF documents anywhere in repo
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg
*.mp4
*.mkv
*.mov
*.avi
*.pdf

# Local agent artifacts
.agents/
